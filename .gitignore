# --- Segredos ---
# NUNCA versionar. `.env.example` (só com valores de exemplo) é a exceção.
.env
.env.*
!.env.example
*.pem
*.key

# --- Banco de dados local ---
# db.sqlite3 carrega dados reais de aluno (CPF, endereço, currículo) e hashes
# de senha. Nunca deve entrar no repositório.
*.sqlite3
*.sqlite3-journal
*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Uploads de usuário ---
media/
staticfiles/

# --- Editores e SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Notas de trabalho ---
mudancas_sthefania.txt

# --- Artefatos do checklist de publicação ---
# `tests/checklist_publicacao.py` grava screenshots e um JSON de resultado
# no diretório onde é executado. São saída de execução, não código.
tests/*.png
tests/checklist-navegador.json
