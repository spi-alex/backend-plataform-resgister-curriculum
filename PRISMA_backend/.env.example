# .env.example — PODE COMPARTILHAR (só valores de exemplo).
# Copie para `.env` e preencha com os valores reais. O `.env` de verdade é
# ignorado pelo git (ver .gitignore na raiz) e NUNCA deve ser commitado.

# --- Django ---
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque_por_uma_chave_gerada

# DEBUG e ALLOWED_HOSTS são lidos do ambiente (core/settings.py). Sem eles
# definidos, o padrão é o SEGURO: DEBUG=False e nenhum host liberado.
# Em produção, mantenha DEBUG=False — com DEBUG=True um erro 500 devolve
# stack trace completo (caminhos, SQL, variáveis) para qualquer visitante.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend / CORS ---
# Origens autorizadas a chamar a API, separadas por vírgula.
# Em dev use `localhost` (e não 127.0.0.1) para o cookie httpOnly do refresh
# token funcionar — ver Prisma_frontend/.env.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SameSite do cookie de refresh. 'Lax' cobre front e back no mesmo site
# (inclusive portas diferentes em localhost). Só troque para 'None' se o
# deploy colocar front e back em DOMÍNIOS diferentes — e 'None' exige HTTPS.
REFRESH_COOKIE_SAMESITE=Lax

# --- E-mail transacional (Resend) ---
# Usado para o código de confirmação de cadastro, o código de recuperação de
# senha e os avisos de login / mudança de status de candidatura.
RESEND_API_KEY=re_exemplo_troque_isto

# --- Cache (opcional) ---
# Os contadores de rate limiting ficam no cache do Django. Sem esta variável
# usa-se LocMemCache, que é POR PROCESSO: rodando com vários workers, cada um
# teria seu próprio contador e o limite efetivo viraria N x o configurado.
# Em produção aponte para um Redis compartilhado.
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# --- Log ---
# LOG_LEVEL=INFO
